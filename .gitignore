# Hyprland rice — allowlist: everything in ~/.config is ignored except the
# folders listed below. To add something: append `!name/` (or `!file`).
/*

!/.gitignore
!/README.md

!/hypr/
!/quickshell/
!/kitty/
!/fish/
!/starship.toml
!/fastfetch/
!/btop/
!/cava/
!/wal/
!/scripts/
!/gtk-3.0/
!/gtk-4.0/
!/qt5ct/
# LazyVim (based on the LazyVim starter)
!/nvim/
!/systemd/
!/pipewire/

# machine state / secrets inside included folders
fish/fish_variables
quickshell/cider-token
# generated by qs (symlink into /run/user); create an empty one to enable qmlls
quickshell/.qmlls.ini
# regenerated on every wallpaper change
scripts/wal.conf
**/__pycache__/
*.pyc
